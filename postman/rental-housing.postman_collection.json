            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('roles = [landlord], пароля в ответе нет', () => { pm.expect(j.roles).to.eql(['landlord']); pm.expect(j).to.not.have.property('password'); });"
                ]
