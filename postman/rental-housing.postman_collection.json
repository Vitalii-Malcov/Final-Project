    {
      "name": "C. Бронирование",
      "item": [
        {
          "name": "C1. Арендатор бронирует (3 ночи)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = n => { const x = new Date(); x.setDate(x.getDate() + n); return x.toISOString().slice(0, 10); };",
                  "pm.collectionVariables.set('start_date', d(10));",
                  "pm.collectionVariables.set('end_date', d(13));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('booking_id', j.id);",
                  "pm.test('3 ночи x 120.00 = 360.00, статус pending', () => { pm.expect(j.total_price).to.eql('360.00'); pm.expect(j.status).to.eql('pending'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bookings/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bookings",
                ""
              ]
            },
            "description": "Цена фиксируется при создании. Бронь начинается со статуса pending.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenant_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listing\": \"{{listing_id}}\",\n  \"start_date\": \"{{start_date}}\",\n  \"end_date\": \"{{end_date}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
