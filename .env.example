# Скопируй в .env и подставь свои значения. Реальный .env в git НЕ коммитим.
# Значение в ОДИНАРНЫХ кавычках: в ключе бывает символ $, а docker compose иначе примет
# $слово за переменную и молча исказит ключ.
SECRET_KEY='change-me'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# На сервере: https://your-domain-or-ip (через запятую)
CSRF_TRUSTED_ORIGINS=

# True -> MySQL, False -> SQLite (для быстрых проверок)
MYSQL=True
MYSQL_DATABASE=rental_housing
MYSQL_USER=rental_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# За сколько дней до заезда ещё можно отменить бронь
BOOKING_CANCELLATION_DEADLINE_DAYS=1

# Только для Docker: пароль root контейнера MySQL
MYSQL_ROOT_PASSWORD=change-me

# Порт приложения на хосте при запуске через docker compose (по умолчанию 8000)
WEB_PORT=8000
